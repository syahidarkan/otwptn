# otwptn environment variables. Copy to .env.local for development.
# Production values live in Vercel -> Project Settings -> Environment Variables (Production scope).
# NEVER commit real values. Variables prefixed NEXT_PUBLIC_ are exposed to the browser.

# --- App URLs -----------------------------------------------------------------------------
# MUST be https://otwptn.com in Production (no trailing slash). Used for the Mayar redirectUrl,
# email links and share links. A localhost value in production sends paying users to localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public by design: it is only safe because every table has RLS. Never put the service key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments -----------------------------------------------------------------------------
# Mayar (primary gateway)
MAYAR_API_KEY=
# Must match the secret configured on the Mayar webhook (Mayar dashboard -> Webhook).
MAYAR_WEBHOOK_SECRET=
# Jago manual-transfer flow
JAGO_ACCOUNT_NUMBER=
JAGO_ACCOUNT_NAME=
# Shared secret the Google Apps Script sends to /api/payment/jago-notify. Use 32+ random bytes.
JAGO_NOTIFY_SECRET=
# DOKU (legacy webhook /api/doku-webhook; leave empty if unused, but then remove the route)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Midtrans (legacy, only read by src/lib/payment.ts; leave empty if unused)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_SANDBOX=

# --- Email --------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@otwptn.com
EMAIL_FROM=noreply@otwptn.com
# Legacy nodemailer/Gmail fallback (src/lib/email). Prefer Resend only.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- AI -----------------------------------------------------------------------------------
GROQ_API_KEY=
# src/lib/ai/client.ts also accepts a Groq key here (gsk_...) or a real OpenAI key.
OPENAI_API_KEY=

# --- Bot protection (Cloudflare Turnstile) --------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WhatsApp service (wa-service/, deployed separately, NOT on Vercel) -----------------------
# Public URL of the deployed wa-service, no trailing slash.
WA_SERVICE_URL=
# Same value as WA_SERVICE_TOKEN in wa-service. Generate: openssl rand -hex 32
WA_SERVICE_TOKEN=
