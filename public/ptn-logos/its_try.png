    <div id="its-video-modal">
        <div class="its-modal-content">
            <div class="its-close-btn">&times;</div>
            <div class="its-video-container">
                <iframe id="its-video-iframe" src="" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            </div>
        </div>
    </div>

    <!-- Custom Lightbox Script -->
    <script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        
        var modal = document.getElementById('its-video-modal');
        var iframe = document.getElementById('its-video-iframe');
        var closeBtn = document.querySelector('.its-close-btn');

        // Helper: Extract Video ID
        function getYoutubeId(url) {
            var regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            var match = url.match(regExp);
            if (match && match[2].length == 11) {
                return match[2];
            }
            return null;
        }

        // Helper: Close Modal
        function closeModal() {
            modal.classList.remove('show');
            setTimeout(function() {
                modal.style.display = 'none';
                iframe.src = ''; // Stop video
            }, 300);
        }

        // Close events
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function(e) {
            if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === "Escape" && modal.style.display === 'flex') closeModal();
        });

        // Click Capture
        document.body.addEventListener('click', function(e) {
            
            // 1. Find the Link
            var linkNode = e.target.closest('a');
            if ( !linkNode ) return;

            // 2. Check for Trigger Class (on link or parent widget)
            var triggerWidget = linkNode.closest('.its-lightbox-trigger');
            var isTrigger = triggerWidget || linkNode.classList.contains('its-lightbox-trigger');
            
            if ( !isTrigger ) return;

            // 3. Check for YouTube URL
            var url = linkNode.href;
            var videoId = getYoutubeId(url);

            if ( !videoId ) return;

            // 4. STOP REDIRECTION
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();

            // 5. Open Custom Modal
            var embedUrl = 'https://www.youtube.com/embed/' + videoId + '?autoplay=1&rel=0';
            iframe.src = embedUrl;
            modal.style.display = 'flex';
            // Force reflow for transition
            void modal.offsetWidth; 
            modal.classList.add('show');

        }, true); // Capture phase
    });
    </script>
    
