    <script>
        (function() {
            var toggle = document.getElementById('its-mobile-menu-toggle');
            var menu   = document.getElementById('its-mobile-menu');
            if (!toggle || !menu) return;

            var rootPanel = document.getElementById('its-mobile-panel-root');
            var panels    = menu.querySelectorAll('.its-mobile-menu-panel');

            function resetPanels() {
                if (!rootPanel) return;
                panels.forEach(function(p) { p.classList.remove('is-active'); });
                rootPanel.classList.add('is-active');
            }

            function openMenu() {
                menu.classList.add('is-open');
                menu.setAttribute('aria-hidden', 'false');
                toggle.classList.add('is-open');
                toggle.setAttribute('aria-expanded', 'true');
                toggle.setAttribute('aria-label', 'Close menu');
                document.body.classList.add('its-mobile-menu-open');
                resetPanels();
            }

            function closeMenu() {
                menu.classList.remove('is-open');
                menu.setAttribute('aria-hidden', 'true');
                toggle.classList.remove('is-open');
                toggle.setAttribute('aria-expanded', 'false');
                toggle.setAttribute('aria-label', 'Open menu');
                document.body.classList.remove('its-mobile-menu-open');
            }

            toggle.addEventListener('click', function() {
                if (menu.classList.contains('is-open')) {
                    closeMenu();
                } else {
                    openMenu();
                }
            });

            menu.querySelectorAll('.its-mobile-menu-item[data-target-panel]').forEach(function(item) {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    var targetId = this.getAttribute('data-target-panel');
                    var target   = document.getElementById(targetId);
                    var current  = menu.querySelector('.its-mobile-menu-panel.is-active');
                    if (target && current) {
                        current.classList.remove('is-active');
                        target.classList.add('is-active');
                    }
                });
            });

            menu.querySelectorAll('.its-mobile-menu-back-btn').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var panel    = this.closest('.its-mobile-menu-panel');
                    var parentId = panel.getAttribute('data-parent-panel');
                    var parent   = parentId ? document.getElementById(parentId) : rootPanel;
                    if (panel && parent) {
                        panel.classList.remove('is-active');
                        parent.classList.add('is-active');
                    }
                });
            });

            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && menu.classList.contains('is-open')) {
                    closeMenu();
                }
            });

            window.addEventListener('resize', function() {
                if (window.innerWidth >= 768 && menu.classList.contains('is-open')) {
                    closeMenu();
                }
            });
        })();
    </script>

    
<style>
	*, *::before, *::after { box-sizing: border-box; }
	body.its-canvas { margin: 0; padding: 0; font-family: sans-serif; background: #FAFCFE; }
	.its-404-wrap {
		max-width: 720px;
		margin: 0 auto;
		padding: 120px 24px 80px;
		text-align: center;
	}
	.its-404-code {
		font-size: 96px;
		font-weight: 700;
		line-height: 1;
		color: #0C64C2;
		margin: 0 0 16px;
	}
	.its-404-title {
		font-size: 28px;
		font-weight: 700;
		color: #007BC0;
		margin: 0 0 12px;
	}
	.its-404-desc {
		font-size: 16px;
		color: #444;
		line-height: 1.6;
		margin: 0 0 32px;
	}
	.its-404-home {
