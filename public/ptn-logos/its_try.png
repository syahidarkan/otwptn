<link rel="https://api.w.org/" href="https://www.its.ac.id/wp-json/" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://www.its.ac.id/xmlrpc.php?rsd" />
                            <style>// Custom CSS for the Play Button
// Add this to Appearance -> Customize -> Additional CSS
.its-video-play-btn {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 60px;
    height: 60px;
    background-color: #ff0000;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    transition: transform 0.3s ease;
    z-index: 10;
    cursor: pointer;
}
.its-video-play-btn:hover {
    transform: scale(1.1);
}
.its-video-play-btn i {
    color: #ffffff;
    font-size: 24px;
    margin-left: 4px;
}

#its-video-modal {
    display: none;
    position: fixed;
    z-index: 999999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: rgba(30, 30, 30, 0.95); /* #1e1e1e with slight opacity */
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
}
#its-video-modal.show {
    display: flex;
    opacity: 1;
}
.its-modal-content {
    position: relative;
    width: 80%; /* 80% of screen width */
    max-width: 1600px; /* Cap at reasonable large size */
    margin: auto;
    background-color: transparent;
}
.its-video-container {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
    height: 0;
    overflow: hidden;
    background: #000;
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    border-radius: 12px;
}
.its-video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
}
.its-close-btn {
    position: absolute;
    top: -50px;
    right: -10px;
    color: #fff;
    font-size: 35px;
    font-weight: 300;
    cursor: pointer;
    line-height: 1;
    transition: 0.2s;
    width: 40px;
    height: 40px;
    text-align: center;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}
.its-close-btn:hover {
    background: rgba(255,255,255,0.1);
    color: #fff;
    transform: scale(1.1);
}

/* Responsive Adjustments */
@media (max-width: 768px) {
    .its-modal-content {
        width: 95%; /* Use more space on mobile */
    }
    .its-close-btn {
        top: -45px;
        right: 0;
    }
}</style>
