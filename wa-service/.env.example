# Port (Railway/Fly.io/Render set ini otomatis)
PORT=3001

# Secret token — same value must be set in Vercel as WA_SERVICE_TOKEN
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_SERVICE_TOKEN=ganti_dengan_random_string_panjang

# Supabase — pakai service role key (bukan anon key)
# Ambil dari: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Only for hosts that sleep idle services (Render free tier): public URL of this service.
# The service pings its own /health every 10 min when set. Leave empty on Fly.io.
SELF_URL=
